# Скопируй в .env и впиши свои значения: cp .env.example .env
# Реальный .env в Git не коммитится.

# Django
SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Almaty
APP_PORT=8000

# PostgreSQL (используется и контейнером db, и бэкендом)
POSTGRES_DB=bookings
POSTGRES_USER=bookings
POSTGRES_PASSWORD=change-me
